# Configuration locale uniquement. Le fichier .env existant n'est pas remplacé.
ASSISTOPS_ENVIRONMENT=local
ASSISTOPS_DATABASE_URL=postgresql://assistops:assistops-local-only@localhost:5432/assistops
ASSISTOPS_QDRANT_URL=http://localhost:6333
ASSISTOPS_DEPENDENCY_TIMEOUT_SECONDS=3
# Shared token bucket per authenticated connector: burst size and refill period.
ASSISTOPS_API_RATE_LIMIT_REQUESTS=120
ASSISTOPS_API_RATE_LIMIT_PERIOD_SECONDS=60
# ASSISTOPS_QDRANT_API_KEY=
# Required for paid retrieval, RAG and routing; never commit the real key.
# OPENAI_API_KEY=
ASSISTOPS_EMBEDDING_MODEL=text-embedding-3-small
ASSISTOPS_EMBEDDING_DIMENSIONS=1536
# Identité locale de démonstration uniquement ; remplacer pour chaque connecteur réel.
ASSISTOPS_WEBHOOK_CONNECTORS={"demo":{"secret":"assistops-local-webhook-secret-32-chars","tenant_id":"demo","allowed_user_ids":["user-001"],"source":"webhook"}}
# Worker modes: disabled, demo, rag, supervisor. Enable one explicitly.
ASSISTOPS_WORKER_PROCESSOR=disabled
ASSISTOPS_WORKER_POLL_SECONDS=1
ASSISTOPS_WORKER_TIMEOUT_SECONDS=20
ASSISTOPS_WORKER_LEASE_SECONDS=60
ASSISTOPS_WORKER_MAX_ATTEMPTS=3
ASSISTOPS_WORKER_RETRY_SECONDS=2

# Server-side RAG permissions. Empty means deny all; enable identities explicitly.
ASSISTOPS_RAG_USER_ROLES={}
ASSISTOPS_RAG_MODEL=gpt-4.1-mini-2025-04-14
# For an AI worker use PROCESSOR=rag or supervisor, TIMEOUT_SECONDS=60, LEASE_SECONDS=90.
# Compose override only (compose.rag.yaml): ASSISTOPS_AI_PROCESSOR=supervisor
# Example: ASSISTOPS_RAG_USER_ROLES={"demo":{"user-001":["customer"]}}

# Synthetic business tools are opt-in outside the local Compose.
ASSISTOPS_BUSINESS_BACKEND=disabled
ASSISTOPS_BUSINESS_USER_ROLES={}
ASSISTOPS_APPROVAL_TTL_SECONDS=900
# Example: {"demo":{"user-001":["customer"],"reviewer-001":["ticket_approver"]}}
# Signed API reviewers must also be authorized by ASSISTOPS_WEBHOOK_CONNECTORS.
# Browser reviewers receive separate connector grants through assistops.review.cli.
ASSISTOPS_REVIEW_UI_ENABLED=false
ASSISTOPS_REVIEW_UI_ORIGIN=http://localhost:8000
ASSISTOPS_REVIEW_SESSION_SECONDS=3600

# Jira is opt-in; credentials belong only to the worker, never to n8n or the LLM.
ASSISTOPS_TICKET_BACKEND=synthetic
# ASSISTOPS_JIRA_SITE=https://your-site.atlassian.net
# ASSISTOPS_JIRA_PROJECT_KEY=OPS
# ASSISTOPS_JIRA_ISSUE_TYPE_ID=
# ASSISTOPS_JIRA_TENANT_ID=demo
# ASSISTOPS_JIRA_CLOUD_ID=
# JIRA_EMAIL=
# JIRA_API_TOKEN=

# Explicit, metrics-only tracing. Ambient LANGSMITH_TRACING does not enable graph exports.
ASSISTOPS_LANGSMITH_ENABLED=false
# EU: https://eu.api.smith.langchain.com; a self-hosted API URL is also supported.
# ASSISTOPS_LANGSMITH_ENDPOINT=https://api.smith.langchain.com
ASSISTOPS_LANGSMITH_PROJECT=assistops
# LANGSMITH_API_KEY=

# Slack Socket Mode: only the dedicated connector receives these tokens.
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=
# SLACK_TEAM_ID=T0123456789
# SLACK_CHANNEL_ID=C0123456789
# SLACK_USER_MAP={"U0123456789":"user-001"}
# SLACK_CONNECTOR_SECRET=
# SLACK_REVIEW_URL=http://localhost:8000/review
