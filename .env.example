# Configuration locale uniquement. Le fichier .env existant n'est pas remplacé.
ASSISTOPS_ENVIRONMENT=local
ASSISTOPS_DATABASE_URL=postgresql://assistops:assistops-local-only@localhost:5432/assistops
ASSISTOPS_QDRANT_URL=http://localhost:6333
ASSISTOPS_DEPENDENCY_TIMEOUT_SECONDS=3
# ASSISTOPS_QDRANT_API_KEY=
# Required for paid retrieval and RAG; never commit the real key.
# OPENAI_API_KEY=
ASSISTOPS_EMBEDDING_MODEL=text-embedding-3-small
ASSISTOPS_EMBEDDING_DIMENSIONS=1536
# Identité locale de démonstration uniquement ; remplacer pour chaque connecteur réel.
ASSISTOPS_WEBHOOK_CONNECTORS={"demo":{"secret":"assistops-local-webhook-secret-32-chars","tenant_id":"demo","allowed_user_ids":["user-001"],"source":"webhook"}}
# Activer explicitement le processeur de démonstration dans le terminal du worker.
ASSISTOPS_WORKER_PROCESSOR=disabled
ASSISTOPS_WORKER_POLL_SECONDS=1
ASSISTOPS_WORKER_TIMEOUT_SECONDS=20
ASSISTOPS_WORKER_LEASE_SECONDS=60
ASSISTOPS_WORKER_MAX_ATTEMPTS=3
ASSISTOPS_WORKER_RETRY_SECONDS=2

# Server-side RAG permissions. Empty means deny all; enable identities explicitly.
ASSISTOPS_RAG_USER_ROLES={}
ASSISTOPS_RAG_MODEL=gpt-4.1-mini-2025-04-14
ASSISTOPS_RAG_DAILY_ATTEMPTS=5
# For a RAG worker use PROCESSOR=rag, TIMEOUT_SECONDS=45 and LEASE_SECONDS=90 above.
# Example: ASSISTOPS_RAG_USER_ROLES={"demo":{"user-001":["customer"]}}
